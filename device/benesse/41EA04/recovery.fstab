# mount point   fstype  device                                          flags
#
# NOTE: mmcblk0p3 is the MBR *extended-partition container* (type 0x05,
# LBA 49152, 1040MB) that holds p5/p6/p7 as logical partitions -- it is NOT a
# misc partition. Never map /misc here: TWRP clears the bootloader control
# block when rebooting to system, and if /misc points at p3 that write zeroes
# the start of the extended partition (its EBR chain), after which p5/p6/p7
# vanish from the kernel's partition list until the chain is rebuilt.
# This happened on the sister device 40S404 (see README, "Do not map /misc").
# The stock recovery.fstab has no /misc entry either.
/boot           emmc    /dev/block/mmcblk0p1
/recovery       emmc    /dev/block/mmcblk0p2                            flags=backup=1
/system         ext4    /dev/block/mmcblk0p5
/cache          ext4    /dev/block/mmcblk0p6                            flags=backup=1
/data           ext4    /dev/block/mmcblk0p4
/factory        ext4    /dev/block/mmcblk0p7                            flags=display="Factory"
