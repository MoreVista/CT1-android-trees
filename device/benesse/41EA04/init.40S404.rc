on boot
    # Marvell sd8787 (SDIO WiFi). mlan.ko (core) must load before
    # sd8787.ko (chip glue) -- same two-stage pattern as the Benesse
    # TAB-A03-BR's Marvell combo chip (see sibling project notes).
    insmod /system/etc/wifi/mlan.ko
    insmod /system/etc/wifi/sd8787.ko
    setprop wlan.driver.status ok

service wpa_supplicant /system/bin/wpa_supplicant \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf \
    -I/system/etc/wifi/wpa_supplicant.conf -O/data/misc/wifi/sockets
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot
