+// 40S404: v_hwc pans the 2-page framebuffer right after its blits, but the IPU only switches pages at
+// the next vsync.  If the next frame is composed before that vsync it is blitted into the page that is
+// still being scanned out (bands of an old picture on screen).  Wait for the vsync that activates the
+// pan before composing again (GLES composition goes through the fb HAL which already waits).
+static void fslWaitPanVsync() {
+    static const bool enabled = property_get_bool("ro.sf.hwc_wait_vsync", true);
+    static int fd = -2;
+    if (!enabled) return;
+    if (fd == -2) fd = open("/dev/graphics/fb0", O_RDWR | O_CLOEXEC);
+    if (fd < 0) return;
+    unsigned long long ts = 0;
+    ioctl(fd, _IOR('F', 0x20, unsigned long long) /* MXCFB_WAIT_FOR_VSYNC */, &ts);
+}
