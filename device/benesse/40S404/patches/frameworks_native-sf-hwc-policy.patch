+void RenderEngine::finish() {
+    glFinish();
+}
+
+// Wait for the GPU queue to drain, but never longer than timeoutNs.  Returns true if it drained.
+bool RenderEngine::finishWithTimeout(int64_t timeoutNs) {
+    EGLDisplay dpy = eglGetCurrentDisplay();
+    if (dpy == EGL_NO_DISPLAY) return false;
+    EGLSyncKHR sync = eglCreateSyncKHR(dpy, EGL_SYNC_FENCE_KHR, NULL);
+    if (sync == EGL_NO_SYNC_KHR) {
+        return false;
+    }
+    EGLint r = eglClientWaitSyncKHR(dpy, sync, EGL_SYNC_FLUSH_COMMANDS_BIT_KHR,
+            static_cast<EGLTimeKHR>(timeoutNs));
+    eglDestroySyncKHR(dpy, sync);
+    return r == EGL_CONDITION_SATISFIED_KHR;
+}
+
 void RenderEngine::flush() {
     glFlush();
 }
