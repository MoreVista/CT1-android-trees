@@ -500,9 +503,22 @@ static void security_failure() {
     while (true) { pause(); }  // never reached
 }
 
+// 40S404: the stock 3.0.35 kernel is built without SELinux (no selinuxfs). Android 7 init treats a
+// failed policy load as a security failure and reboots into recovery, so skip all SELinux setup there.
+static bool kernel_has_selinux() {
+    std::string filesystems;
+    if (!read_file("/proc/filesystems", &filesystems)) return true;
+    return filesystems.find("selinuxfs") != std::string::npos;
+}
+
 static void selinux_initialize(bool in_kernel_domain) {
     Timer t;
 
+    if (!kernel_has_selinux()) {
+        NOTICE("Kernel has no SELinux support; skipping policy load\n");
+        return;
+    }
+
     selinux_callback cb;
     cb.func_log = selinux_klog_callback;
     selinux_set_callback(SELINUX_CB_LOG, cb);
@@ -617,7 +633,7 @@ int main(int argc, char** argv) {
     // If we're in the kernel domain, re-exec init to transition to the init domain now
     // that the SELinux policy has been loaded.
     if (is_first_stage) {
-        if (restorecon("/init") == -1) {
+        if (kernel_has_selinux() && restorecon("/init") == -1) {
             ERROR("restorecon failed: %s\n", strerror(errno));
             security_failure();
         }
