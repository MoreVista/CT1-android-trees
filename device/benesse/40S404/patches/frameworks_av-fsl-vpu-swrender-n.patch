+// 40S404: persist.sys.fsl.hwrender=1 lets the Freescale VPU decoder write straight into native-window
+// (gralloc) buffers instead of the CPU-readable ByteBuffer + SoftwareRenderer route.
+static bool fslHwRender() {
+    char value[PROPERTY_VALUE_MAX];
+    property_get("persist.sys.fsl.hwrender", value, "1");
+    return value[0] == '1';
+}
+
+// The i.MX gralloc does not understand raw OMX colour-format values; map them to its own HAL formats.
+static int fslNativeFormatFromOmx(const char *component, int f) {
+    if (strncmp(component, "OMX.Freescale.", 14)) {
+        return f;
+    }
+    switch (f) {
+        case OMX_COLOR_Format16bitRGB565:           return HAL_PIXEL_FORMAT_RGB_565;
+        case OMX_COLOR_FormatYUV420Planar:          return 0x101;
+        case OMX_COLOR_FormatYUV420SemiPlanar:      return 0x103;
+        case OMX_COLOR_FormatYUV420PackedSemiPlanar:return 0x100;
+        default:                                    return f;
+    }
+}
