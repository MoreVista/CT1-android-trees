 namespace android {
 
+// 40S404: the stock Freescale VPU stack (libvpu -> g2d_alloc -> gcoOS_AllocateVideoMemory) assumes
+// the Vivante GAL device was already constructed in the process hosting the OMX components
+// (on 4.2 something in mediaserver did that); in the mediacodec process nobody does, and libGAL
+// dereferences a NULL gcoOS (fault addr 0x10). Open a g2d context once to construct it.
+static void fslInitGal() {
+    static void *sG2dHandle = NULL;
+    if (sG2dHandle != NULL) return;
+    void *lib = dlopen("libg2d.so", RTLD_NOW | RTLD_GLOBAL);
+    if (lib == NULL) return;
+    int (*g2dOpen)(void **) = reinterpret_cast<int (*)(void **)>(dlsym(lib, "g2d_open"));
+    if (g2dOpen != NULL && g2dOpen(&sG2dHandle) != 0) {
+        sG2dHandle = NULL;
+    }
+}
+
 OMXMaster::OMXMaster() {
+    fslInitGal();
 
