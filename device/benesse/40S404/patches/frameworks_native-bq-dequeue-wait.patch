@@ -103,6 +104,16 @@ status_t BufferQueueProducer::setMaxDequeuedBufferCount(
             return NO_INIT;
         }
 
+        // 40S404: the Vivante EGL occasionally dequeues a third buffer before the previous one
+        // has been queued (swap with EGL_BUFFER_PRESERVED); with maxDequeued=2 that fails with
+        // "attempting to exceed the max dequeued buffer count" and HWUI stops rendering.
+        {
+            static const int minMaxDequeued = property_get_int32("ro.bq.min_max_dequeued", 0);
+            if (maxDequeuedBuffers > 0 && maxDequeuedBuffers < minMaxDequeued) {
+                maxDequeuedBuffers = minMaxDequeued;
+            }
+        }
+
         if (maxDequeuedBuffers == mCore->mMaxDequeuedBufferCount) {
             return NO_ERROR;
         }
@@ -244,6 +255,7 @@ status_t BufferQueueProducer::waitForFreeSlotThenRelock(FreeSlotCaller caller,
     auto callerString = (caller == FreeSlotCaller::Dequeue) ?
             "dequeueBuffer" : "attachBuffer";
     bool tryAgain = true;
+    nsecs_t waitedForQueue = 0;
     while (tryAgain) {
         if (mCore->mIsAbandoned) {
             BQ_LOGE("%s: BufferQueue has been abandoned", callerString);
@@ -266,6 +278,18 @@ status_t BufferQueueProducer::waitForFreeSlotThenRelock(FreeSlotCaller caller,
         // This check is only done if a buffer has already been queued
         if (mCore->mBufferHasBeenQueued &&
                 dequeuedCount >= mCore->mMaxDequeuedBufferCount) {
+            // 40S404: the Vivante EGL starts the next frame's dequeue while the previous frame's
+            // queueBuffer is still in flight (SurfaceFlinger busy), which is one dequeue too many.
+            // Wait a little for that queueBuffer instead of failing: a failed dequeue makes HWUI
+            // stop rendering (EGL_BAD_NATIVE_WINDOW) and the app looks frozen.
+            static const nsecs_t maxWait =
+                    ms2ns(property_get_int32("ro.bq.dequeue_wait_ms", 0));
+            if (waitedForQueue < maxWait) {
+                nsecs_t start = systemTime(SYSTEM_TIME_MONOTONIC);
+                mCore->mDequeueCondition.waitRelative(mCore->mMutex, maxWait - waitedForQueue);
+                waitedForQueue += systemTime(SYSTEM_TIME_MONOTONIC) - start;
+                continue;
+            }
             BQ_LOGE("%s: attempting to exceed the max dequeued buffer count "
                     "(%d)", callerString, mCore->mMaxDequeuedBufferCount);
             return INVALID_OPERATION;
