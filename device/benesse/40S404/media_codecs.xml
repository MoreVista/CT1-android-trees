<?xml version="1.0" encoding="utf-8" ?>
<!-- Software (OMX.google.*) codecs only. The stock file also listed
     OMX.Freescale.* VPU components; those need the Freescale OMX core and
     stagefright glue that this CM tree does not have yet. -->
