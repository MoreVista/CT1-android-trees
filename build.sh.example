#!/bin/bash
# usage: build.sh '<make command>'   e.g. build.sh 'mka bacon'
# The author ran this inside a bubblewrap Ubuntu 14.04 chroot ("loshell"); adapt to your own build environment.
exec <your-chroot-launcher> bash -lc "source build/envsetup.sh >/dev/null 2>&1; lunch cm_40S404-userdebug >/dev/null 2>&1; $1"
