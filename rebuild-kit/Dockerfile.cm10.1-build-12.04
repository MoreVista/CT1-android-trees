FROM ubuntu:12.04
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i 's/archive.ubuntu.com/old-releases.ubuntu.com/g; s/security.ubuntu.com/old-releases.ubuntu.com/g' /etc/apt/sources.list
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-6-jdk git-core gnupg flex bison gperf build-essential zip curl \
    zlib1g-dev gcc-multilib g++-multilib libc6-dev-i386 lib32ncurses5-dev \
    x11proto-core-dev libx11-dev lib32z1-dev libgl1-mesa-dev libxml2-utils \
    xsltproc unzip python bc lzop cpio ccache rsync libssl-dev ca-certificates \
    schedtool g++-multilib libswitch-perl \
    libsdl1.2-dev libesd0-dev libwxgtk2.8-dev \
    && rm -rf /var/lib/apt/lists/*
ARG UID=1000
ARG GID=1000
RUN groupadd -g $GID build && useradd -m -u $UID -g $GID build
USER build
ENV USER=build LC_ALL=C
WORKDIR /src
